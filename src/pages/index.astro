---
import '../styles/global.css';

const members = [
  'Dagfinn Sund · saxophone',
  'Anders Angell-Olsen · trumpet',
  'Morten Tørmoen · trombone'
];

const regularWork = [
  'Romerike Soulservice',
  'Karlstadpojkarna',
  'Ronny Aagren'
];

const gallery = [
  { src: '/images/morten-09.jpg', alt: 'Affordable Horns with Ronny Aagren Band', position: 'center bottom' },
  { src: '/images/morten-06.jpg', alt: 'Affordable Horns with Karlstadpojkarna', position: 'center top' },
  { src: '/images/morten-12.jpg', alt: 'Affordable Horns playing together', position: 'center 35%' }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Affordable Horns is a versatile, high-impact horn section for live performances, recordings, and special events." />
    <meta property="og:title" content="Affordable Horns" />
    <meta property="og:description" content="A versatile, high-impact horn section for live performances, recordings, and special events." />
    <meta property="og:image" content="/images/morten-06.jpg" />
    <link rel="canonical" href="https://affordablehorns.no/" />
    <title>Affordable Horns · Live horn section</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Affordable Horns home">Affordable Horns</a>
      <nav aria-label="Main navigation">
        <a href="#section">The section</a>
        <a href="#media">Listen / watch</a>
        <a href="#arrangements">Arrangements</a>
        <a href="#contact">Book us</a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy reveal">
          <p class="eyebrow">Live horns / studio / events</p>
          <h1 id="hero-title">Need Big sound?<br /><em>Reach out.</em></h1>
          <p class="hero-intro">We are <strong>Affordable Horns</strong>, a versatile, high-impact horn section for live performances, recordings, and special events. Don’t let the name fool you: we mean serious business.</p>
          <a class="text-link" href="#contact">Bring in the horns <span aria-hidden="true">↘</span></a>
        </div>
        <div class="hero-visual reveal" aria-label="Affordable Horns performing">
          <img src={gallery[0].src} alt={gallery[0].alt} style={`object-position: ${gallery[0].position}`} />
          <span class="hero-stamp">Trumpet · sax · trombone</span>
        </div>
      </section>

      <section class="section section-grid" id="section" aria-labelledby="section-title">
        <div class="section-intro">
          <p class="eyebrow">The horn section</p>
          <h2 id="section-title">Affordable<br /><em>Horns.</em></h2>
        </div>
        <div>
          <p class="section-copy">Anders hits the high notes, Dagfinn brings the wild solos, and Morten delivers the big sound while keeping things tight. Need horns for your music? Reach out.</p>
          <div class="gallery" aria-label="Affordable Horns performance photos">
            {gallery.map((image) => (
              <img src={image.src} alt={image.alt} style={`object-position: ${image.position}`} loading="lazy" />
            ))}
          </div>
          <div class="credits">
            <div class="credit-group">
              <p class="credit-label">The players</p>
              <ul>
                {members.map((member) => <li>{member}</li>)}
              </ul>
            </div>
            <div class="credit-group">
              <p class="credit-label">Regular work</p>
              <ul>
                {regularWork.map((project) => <li>{project}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section class="section media-section" id="media" aria-labelledby="media-title">
        <div class="section-grid media-grid">
          <div class="section-intro">
            <p class="eyebrow">Hear us / see us</p>
            <h2 id="media-title">A little<br /><em>noise.</em></h2>
          </div>
          <div class="media-content">
            <div class="video-list">
              <div class="video-item video-item-wide">
                <div class="video-frame video-frame-wide">
                  <iframe
                    src="https://www.youtube.com/embed/RMD35xVVEak"
                    title="Affordable Horns Oktoberfest teaser"
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                  ></iframe>
                </div>
                <p class="media-label">Oktoberfest teaser</p>
              </div>
              <div class="video-item">
                <div class="video-frame video-frame-short">
                  <iframe
                    src="https://www.youtube.com/embed/jCGXLYjd8lI"
                    title="Affordable Horns live performance short"
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                  ></iframe>
                </div>
                <p class="media-label">Live performance · short</p>
              </div>
              <div class="video-item">
                <div class="video-frame video-frame-short">
                  <iframe
                    src="https://www.youtube.com/embed/fgiJCuLXXZk"
                    title="Affordable Horns live performance short"
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                  ></iframe>
                </div>
                <p class="media-label">Live performance · short</p>
              </div>
            </div>
            <div class="soundcloud-card">
              <p class="credit-label">SoundCloud clip</p>
              <iframe
                width="100%"
                height="166"
                allow="autoplay"
                loading="lazy"
                src="https://w.soundcloud.com/player/?url=https%3A//soundcloud.com/mortentormoen/late-in-the-evening&color=%23bd5b3e&auto_play=false&hide_related=true&show_comments=false&show_user=false&show_reposts=false&show_teaser=false"
                title="Affordable Horns SoundCloud clip"
              ></iframe>
            </div>
          </div>
        </div>
      </section>

      <section class="arrangements-cta" id="arrangements" aria-labelledby="arrangements-title">
        <div class="arrangements-inner">
          <div>
            <p class="eyebrow">Need the charts?</p>
            <h2 id="arrangements-title">Grab the<br /><em>arrangements.</em></h2>
          </div>
          <div class="arrangements-copy">
            <p>Looking for music arranged for horns? Browse Morten's catalog of arrangements for horn sections, bands, and big bands on tormoen.no.</p>
            <a class="text-link" href="https://tormoen.no/#arrangements" target="_blank" rel="noreferrer">Browse arrangements <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <section class="big-band-cta" aria-labelledby="big-band-title">
        <div class="big-band-inner">
          <div>
            <p class="eyebrow">Need the full force?</p>
            <h2 id="big-band-title">Find Ett Fett<br /><em>Storband.</em></h2>
          </div>
          <div class="big-band-copy">
            <p>Need the best Big Band? Find Ett Fett Storband for a bigger stage, a bigger sound, and a whole lot more brass.</p>
            <a class="text-link" href="https://ettfett.no" target="_blank" rel="noreferrer">Visit ettfett.no <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <section class="contact" id="contact" aria-labelledby="contact-title">
        <div class="contact-inner">
          <p class="eyebrow">Have a gig in mind?</p>
          <h2 id="contact-title">Let’s<br /><em>make it loud.</em></h2>
          <p class="contact-copy">Tell us what you are working on, where you are playing, and what kind of horn sound you need. We will get back to you with a straightforward answer.</p>
          <div class="contact-links">
            <a class="contact-link" href="mailto:morten@tormoen.no">morten@tormoen.no <span aria-hidden="true">↗</span></a>
            <a class="contact-link" href="tel:+4797774777">977 74 777 <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <span>© {new Date().getFullYear()} Affordable Horns</span>
      <a href="#top">Back to top ↑</a>
    </footer>
  </body>
</html>
